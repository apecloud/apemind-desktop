+/** Exercise the native POSIX lease primitive used by session persistence. */
+async function checkSystemFlock() {
+  if (process.platform === 'win32') return
+  const { tryLockExclusive } = requireRuntime('@deepseek-ai/node-addon-system/flock')
+  const file = join(scratch, 'lease')
+  writeFileSync(file, '', { flag: 'wx', mode: 0o600 })
+  const second = openSync(file, 'r+')
+  try {
+    const first = openSync(file, 'r+')
+    try {
+      await tryLockExclusive(first)
+      await assert.rejects(tryLockExclusive(second), error => ['EAGAIN', 'EWOULDBLOCK'].includes(error.code))
+    } finally {
+      closeSync(first)
+    }
+    await tryLockExclusive(second)
+  } finally {
+    closeSync(second)
+  }
+}
