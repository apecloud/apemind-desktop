+/**
+ * Resolve the tar implementation used to inspect release archives. Windows
+ * runners may expose a POSIX ``tar`` first in PATH; that binary interprets a
+ * drive-letter path as a remote archive. Use the native implementation there.
+ */
+export function releaseTarCommand(): string {
+  return process.platform === 'win32' ? (process.env.DSH_DESKTOP_TAR ?? 'C:\\Windows\\System32\\tar.exe') : 'tar'
+}
