+function replaceTestHostTarball(seed: string, body: string): string {
+  const descriptorPath = join(seed, DESKTOP_PACKAGE_SET_FILE)
+  const descriptor = JSON.parse(readFileSync(descriptorPath, 'utf8')) as {
+    packages: Array<{ name: string; file: string; bytes: number; integrity: string }>
+  }
+  const host = descriptor.packages.find(entry => entry.name === '@deepseek-ai/dsh-desktop-host')!
+  writeFileSync(join(seed, DESKTOP_PACKAGES_DIR, host.file), body)
+  host.bytes = Buffer.byteLength(body)
+  host.integrity = `sha512-${createHash('sha512').update(body).digest('base64')}`
+  writeFileSync(descriptorPath, JSON.stringify(descriptor))
+  writeIntegrity(seed)
+  return host.file
+}
+
+it('installs changed core content at the same version and preserves user plugins', async () => {
+  const root = temporaryRoot()
+  const seed = join(root, 'seed')
+  createTestSeedMetadata(seed, release())
+  writeFileSync(join(seed, 'pnpm-lock.yaml'), 'lockfileVersion: 9\n')
+  archiveStore(seed)
+  writeIntegrity(seed)
+  const paths = resolveDesktopPaths(join(root, '.dsh'))
+  const manager = new DesktopProjectManager(paths, { node: process.execPath, pnpm: writeFakePnpm(root) })
+  await manager.applyRelease(seed, '1.0.0', hooks())
+  await manager.mutate({ type: 'plugin-add', spec: '@scope/plugin@2.0.0' }, hooks())
+  const originalManifest = JSON.parse(readFileSync(join(paths.profile, 'package.json'), 'utf8'))
+  const file = replaceTestHostTarball(seed, 'updated host at the same version')
+  await expect(manager.applyRelease(seed, '1.0.0', hooks())).resolves.toBe(true)
+  expect(readFileSync(join(paths.profile, DESKTOP_PACKAGES_DIR, file), 'utf8')).toBe('updated host at the same version')
+  expect(manager.listPlugins()).toEqual([{ name: '@scope/plugin', version: '2.0.0' }])
+  const updatedManifest = JSON.parse(readFileSync(join(paths.profile, 'package.json'), 'utf8'))
+  expect(updatedManifest.dsh.profile.bundles).toEqual(originalManifest.dsh.profile.bundles)
+  let calls = 0
+  const count = async (): Promise<void> => { calls += 1 }
+  await expect(manager.applyRelease(seed, '1.0.0', hooks({ healthCheck: count, beforeActivate: count, afterActivate: count }))).resolves.toBe(false)
+  expect(calls).toBe(0)
+})
+
+it.each(['healthCheck', 'afterActivate'] as const)('restores original core content after same-version %s failure', async (phase) => {
+  const root = temporaryRoot()
+  const seed = join(root, 'seed')
+  createTestSeedMetadata(seed, release())
+  writeFileSync(join(seed, 'pnpm-lock.yaml'), 'lockfileVersion: 9\n')
+  archiveStore(seed)
+  writeIntegrity(seed)
+  const paths = resolveDesktopPaths(join(root, '.dsh'))
+  const manager = new DesktopProjectManager(paths, { node: process.execPath, pnpm: writeFakePnpm(root) })
+  await manager.applyRelease(seed, '1.0.0', hooks())
+  await manager.mutate({ type: 'plugin-add', spec: '@scope/plugin@2.0.0' }, hooks())
+  const file = replaceTestHostTarball(seed, 'updated host at the same version')
+  const original = readFileSync(join(paths.profile, DESKTOP_PACKAGES_DIR, file))
+  let calls = 0
+  await expect(manager.applyRelease(seed, '1.0.0', hooks({
+    [phase]: async () => {
+      calls += 1
+      if (calls === 1) throw new Error('synthetic update failure')
+    },
+  }))).rejects.toThrow('synthetic update failure')
+  expect(readFileSync(join(paths.profile, DESKTOP_PACKAGES_DIR, file))).toEqual(original)
+  expect(manager.listPlugins()).toEqual([{ name: '@scope/plugin', version: '2.0.0' }])
+  expect(existsSync(paths.pending)).toBe(false)
+  for (const entry of readdirSync(paths.staging)) {
+    expect(existsSync(join(paths.staging, entry, 'profile'))).toBe(false)
+  }
+  await expect(manager.applyRelease(seed, '1.0.0', hooks())).resolves.toBe(true)
+  expect(readFileSync(join(paths.profile, DESKTOP_PACKAGES_DIR, file), 'utf8')).toBe('updated host at the same version')
+})
